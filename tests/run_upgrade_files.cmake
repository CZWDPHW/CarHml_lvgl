if(NOT TEST_EXE OR NOT TEST_ROOT)
    message(FATAL_ERROR "Missing test executable or fixture root")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef case_id)
set(case_dir "${TEST_ROOT}/${case_id}")
file(MAKE_DIRECTORY "${case_dir}")
execute_process(COMMAND "${TEST_EXE}" WORKING_DIRECTORY "${case_dir}" RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Upgrade file test failed: ${result}; fixtures: ${case_dir}")
endif()
